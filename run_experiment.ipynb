   "source": [
    "# ==============================================================================\n",
    "#  LOCATION PRIOR ON OTHER ROAD-ANOMALY BENCHMARKS (Appendix F.9) -- labels\n",
    "#  only, CPU; needs only the setup cells. Downloads the public label masks of\n",
    "#  the benchmarks below, adds the StreetHazards test labels already on disk,\n",
    "#  and scores the model-free location map on each\n",
    "#  (tools/benchmark_location_map.py). Outputs: OUTPUT_DIR/benchmarks/.\n",
    "#\n",
    "#  Label encodings (from each benchmark's documentation):\n",
    "#    RoadAnomaly (Lis et al., 2019): labels_semantic.png, 0 = background, 2 = anomaly\n",
    "#    Fishyscapes Lost & Found (validation, 100 labels): 1 = anomaly, 255 = void\n",
    "#    SegmentMeIfYouCan RoadAnomaly21 / RoadObstacle21 (validation): 1 = anomaly, 255 = void\n",
    "#  A failed download is reported and skipped; re-running the cell retries it.\n",
    "# ==============================================================================\n",
    "import os, glob, subprocess, hashlib, shutil\n",
    "from pathlib import Path\n",
    "from src.config import CONFIG\n",
    "from src.dataset import detect_anomaly_value\n",
    "\n",
    "BENCH = Path(CONFIG.get(\"OUTPUT_DIR\", \"/content/drive/MyDrive/dissertation_outputs\")) / \"benchmarks\"\n",
    "DL = Path(\"/content/benchmark_labels\"); DL.mkdir(parents=True, exist_ok=True)\n",
    "# name: ([urls, tried in order], md5 or None, mask glob, anomaly values, void values, group regex or None)\n",
    "# Fishyscapes Lost & Found frames come from recorded sequences: files are grouped by\n",
    "# recording location (e.g. \"04_Maurener_Weg_8\") so that neighbouring frames of the\n",
    "# same scene never sit in different folds. The SMIYC globs take only the label masks\n",
    "# (*_labels_semantic.png), not the colour-coded copies (*_labels_semantic_color.png).\n",
    "SOURCES = {\n",
    "    \"RoadAnomaly\": ([\"https://datasets-cvlab.epfl.ch/2019-road-anomaly/RoadAnomaly_jpg.zip\"],\n",
    "                    None, \"**/labels_semantic.png\", \"2\", \"\", None),\n",
    "    \"FS_LostAndFound_val\": ([\"https://zenodo.org/records/6511227/files/fishyscapes_lostandfound.zip?download=1\",\n",
    "                             \"http://robotics.ethz.ch/~asl-datasets/Fishyscapes/fishyscapes_lostandfound.zip\"],\n",
    "                            \"0d3bf7c0ec38bd50b84f3d8aaa4b2e26\", \"**/*_labels.png\", \"1\", \"255\",\n",
    "                            r\"^\\d+_(.+?)_\\d{6}_\\d{6}_labels\\.png$\"),\n",
    "    \"SMIYC_RoadAnomaly21_val\": ([\"https://zenodo.org/record/5270237/files/dataset_AnomalyTrack.zip\"],\n",
    "                                None, \"**/labels_masks/*_labels_semantic.png\", \"1\", \"255\", None),\n",
    "    \"SMIYC_RoadObstacle21_val\": ([\"https://zenodo.org/record/5281633/files/dataset_ObstacleTrack.zip\"],\n",
    "                                 None, \"**/labels_masks/*_labels_semantic.png\", \"1\", \"255\", None),\n",
    "}\n",
    "\n",
    "def fetch(name, urls, md5):\n",
    "    \"\"\"Download and unzip into DL/name; True on success. A '.done' marker records success.\"\"\"\n",
    "    d = DL / name\n",
    "    if (d / \".done\").exists():\n",
    "        return True\n",
    "    for url in urls:\n",
    "        shutil.rmtree(d, ignore_errors=True); d.mkdir(parents=True)\n",
    "        z = d / \"a.zip\"\n",
    "        r = subprocess.run([\"wget\", \"-q\", \"--tries=2\", \"--timeout=60\", \"-O\", str(z), url])\n",
    "        if r.returncode != 0 or not z.exists() or z.stat().st_size == 0:\n",
    "            print(f\"   download failed (wget exit {r.returncode}): {url}\"); continue\n",
    "        if md5 and hashlib.md5(z.read_bytes()).hexdigest() != md5:\n",
    "            print(f\"   checksum mismatch: {url}\"); continue\n",
    "        if subprocess.run([\"unzip\", \"-q\", \"-o\", str(z), \"-d\", str(d)]).returncode != 0:\n",
    "            print(f\"   unzip failed: {url}\"); continue\n",
    "        (d / \".done\").write_text(url)\n",
    "        return True\n",
    "    shutil.rmtree(d, ignore_errors=True)\n",
    "    return False\n",
    "\n",
    "for name, (urls, md5, pattern, anom, void, group_rx) in SOURCES.items():\n",
    "    if not fetch(name, urls, md5):\n",
    "        print(f\"{name}: SKIPPED (no source reachable)\"); continue\n",
    "    files = sorted(glob.glob(str(DL / name / pattern), recursive=True))\n",
    "    print(f\"{name}: {len(files)} mask files, e.g. {files[:2]}\")\n",
    "    if len(files) < 10:\n",
    "        print(\"   -> fewer than 10 masks matched; check the glob above; skipped\"); continue\n",
    "    cmd = [\"python3\", \"tools/benchmark_location_map.py\", \"--name\", name, \"--masks\", str(DL / name / pattern),\n",
    "           \"--anomaly\", anom, \"--void\", void, \"--folds\", \"5\", \"--out\", str(BENCH)]\n",
    "    if group_rx:\n",
    "        cmd += [\"--group-regex\", group_rx]\n",
    "    r = subprocess.run(cmd)\n",
    "    if r.returncode != 0:\n",
    "        print(f\"   -> scoring failed for {name} (see the message above); skipped\")\n",
    "\n",
    "# StreetHazards test labels (both towns; folds = towns, as in the study)\n",
    "root = CONFIG[\"STREETHAZARDS_ROOT\"]\n",
    "av = detect_anomaly_value(root)\n",
    "subprocess.run([\"python3\", \"tools/benchmark_location_map.py\", \"--name\", \"StreetHazards_test\",\n",
    "                \"--masks\", os.path.join(root, \"test/annotations/test/*/*.png\"), \"--anomaly\", str(av),\n",
    "                \"--group-by-parent\", \"--out\", str(BENCH)], check=True)\n",
    "print(open(BENCH / \"location_map_benchmarks.md\").read())\n",
    "print(\"StreetHazards here uses all 1,500 test images; the dissertation's 0.7863 used the 1,200-image \"\n",
    "      \"held-out subset, so expect a close but not identical value.\")"
   ],
   "execution_count": null,
   "outputs": []
  },
