    "# ==============================================================================\n",
    "#  PHASE III -- compression-ratio study: len(CONFIG[\"SEEDS\"]) seeds per ratio.\n",
    "#  lambda_sem is re-selected for the low and high ratios (5 selection seeds per\n",
    "#  candidate); the medium ratio reuses the Phase I production models.\n",
    "#  Resumable: (ratio, seed) results stored with the current settings are reused.\n",
    "#\n",
    "#  GPU memory: the Phase I cell keeps the 15 production repetitions on the GPU\n",
    "#  (about 8.4 GB). Once every medium-ratio result is stored, this cell releases\n",
    "#  them (with them on the GPU, training at the high ratio ran out of memory on a\n",
    "#  24 GB L4). Later cells that need them require a session restart, the setup\n",
    "#  cells and the Phase I cell first.\n",
    "# ==============================================================================\n",
    "import gc, json, torch\n",
    "from pathlib import Path\n",
    "from phases.phase3_compression import phase3\n",
    "_state_path = Path(p1_grid[\"out\"]) / \"phase3_multiseed_state.json\"\n",
    "_state = json.load(open(_state_path)) if _state_path.exists() else {}\n",
    "if len(_state.get(CONFIG[\"DEFAULT_CR\"], {})) >= len(CONFIG[\"SEEDS\"]):\n",
    "    _before = torch.cuda.memory_allocated() / 1e9\n",
    "    for _r in p1_grid[\"final_runs\"]:\n",
    "        for _k in (\"jscc_a\", \"jscc_b\", \"max_logit_det\", \"prototype_det\"):\n",
    "            _r[_k] = None\n",
    "    gc.collect()\n",
    "    torch.cuda.empty_cache()\n",
    "    print(f\"GPU memory allocated: {_before:.2f} GB before release, \"\n",
    "          f\"{torch.cuda.memory_allocated() / 1e9:.2f} GB after\")\n",
    "else:\n",
    "    print(f\"CR={CONFIG['DEFAULT_CR']} not finished: Phase I models kept on the GPU (needed for it).\")\n",
    "p3 = phase3(p1_grid, CONFIG, device)"
   ],
