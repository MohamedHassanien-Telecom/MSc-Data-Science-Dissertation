    "# ==============================================================================\n",
    "#  SETUP 1/4 -- download and verify StreetHazards (official release)\n",
    "# ==============================================================================\n",
    "# Source: https://github.com/hendrycks/anomaly-seg (Hendrycks et al., 2022).\n",
    "# Both archives are extracted under one root, which the paths cell sets as\n",
    "# CONFIG[\"STREETHAZARDS_ROOT\"]. The MD5 values are those used by the\n",
    "# StreetHazards loader of pytorch-ood; a mismatch is reported, not fatal.\n",
    "import hashlib\n",
    "import shutil\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "ROOT = Path(\"/content/datasets/streethazards\")\n",
    "ARCHIVES = {\n",
    "    \"streethazards_train.tar\": (\"https://people.eecs.berkeley.edu/~hendrycks/streethazards_train.tar\",\n",
    "                                \"cd2d1a8649848afb85b5059d227d2090\"),\n",
    "    \"streethazards_test.tar\": (\"https://people.eecs.berkeley.edu/~hendrycks/streethazards_test.tar\",\n",
    "                               \"8c547c1346b00c21b2483887110bfea7\"),\n",
    "}\n",
    "ROOT.mkdir(parents=True, exist_ok=True)\n",
    "for name, (url, md5) in ARCHIVES.items():\n",
    "    done = ROOT / f\".{name}.done\"\n",
    "    if done.exists():\n",
    "        print(f\"{name}: already extracted\")\n",
    "        continue\n",
    "    tar = Path(\"/content\") / name\n",
    "    print(f\"Downloading {url} ...\")\n",
    "    subprocess.run([\"wget\", \"-q\", \"-O\", str(tar), url], check=True)\n",
    "    h = hashlib.md5()\n",
    "    with open(tar, \"rb\") as f:\n",
    "        for chunk in iter(lambda: f.read(1 << 24), b\"\"):\n",
    "            h.update(chunk)\n",
    "    if h.hexdigest() != md5:\n",
    "        print(f\"  WARNING: MD5 {h.hexdigest()} differs from the expected {md5}\")\n",
    "    subprocess.run([\"tar\", \"-xf\", str(tar), \"-C\", str(ROOT)], check=True)\n",
    "    tar.unlink()\n",
    "    done.write_text(url)\n",
    "    print(f\"  extracted into {ROOT}\")\n",
    "\n",
    "# src/dataset.py reads the test towns from test/{images,annotations}/test/{t5,t6};\n",
    "# move them there if the archive stores them one level higher.\n",
    "for kind in (\"images\", \"annotations\"):\n",
    "    base = ROOT / \"test\" / kind\n",
    "    towns = sorted(p for p in base.glob(\"t*\") if p.is_dir()) if base.exists() else []\n",
    "    if towns and not (base / \"test\").exists():\n",
    "        (base / \"test\").mkdir()\n",
    "        for t in towns:\n",
    "            shutil.move(str(t), str(base / \"test\" / t.name))\n",
    "\n",
    "# The folders src/dataset.py reads.\n",
    "required = {\n",
    "    \"train/images/training\": \"train images (towns 1-3)\",\n",
    "    \"train/annotations/training\": \"train annotations (towns 1-3)\",\n",
    "    \"train/images/validation\": \"validation images (town 4)\",\n",
    "    \"train/annotations/validation\": \"validation annotations (town 4)\",\n",
    "    \"test/images/test\": \"test images (towns 5, 6)\",\n",
    "    \"test/annotations/test\": \"test annotations (towns 5, 6)\",\n",
    "}\n",
    "all_ok = True\n",
    "for rel, label in required.items():\n",
    "    p = ROOT / rel\n",
    "    n = len(list(p.rglob(\"*.png\"))) if p.exists() else 0\n",
    "    print(f\"  [{'OK' if n else 'MISSING'}] {label}: {n} .png files in {p}\")\n",
    "    all_ok &= n > 0\n",
    "if not all_ok:\n",
    "    print(\"\\nUnexpected layout. Folders found under the root:\")\n",
    "    for p in sorted(ROOT.glob(\"*/*/*\")):\n",
    "        print(\"  \", p)\n",
    "else:\n",
    "    print(\"\\nAll dataset folders found.\")"
   ],
   "execution_count": null,
   "outputs": []
  },
