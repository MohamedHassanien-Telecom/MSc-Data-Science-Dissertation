    "## Controls (dissertation Section 3.1.9 and Appendix F)\n",
    "\n",
    "The evaluation cells below need the Phase I models in memory. Phase III releases them once its\n",
    "medium-ratio results are stored: in that case restart the session and run the setup cells and the\n",
    "Phase I cell first. All of them are evaluation only and resumable."
   ]
  },
  {
   "cell_type": "code",
   "id": "cell13",
   "metadata": {},
   "source": [
    "# ==============================================================================\n",
    "#  SCORING-RULE CHECK 1/3 (Appendix F.5) -- pixel AUROC of Max Logit, Prototype\n",
    "#  and the magnitude-aware Prototype scoring (the same trained Prototype weights)\n",
    "#  for every production repetition at the diagnostic SNRs, AWGN, with the seeded\n",
    "#  channel noise of Phase II. Evaluation only; resumable per repetition\n",
    "#  (OUTPUT_DIR/run_0/explainer_state.json).\n",
    "# ==============================================================================\n",
    "import json\n",
    "import torch\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from src.models import PrototypeDetectorMagnitudeAware\n",
    "from src.evaluate import _eval_one_system, eval_noise_seed\n",
    "from src.config import training_fingerprint, evaluation_fingerprint, fingerprint_key\n",
    "\n",
    "_EXPLAIN_SNRS = [20, 10, 5, 0, -5, -10, -15, -20]\n",
    "\n",
    "\n",
    "def _scoring_rule_aurocs(p1):\n",
    "    \"\"\"Pixel AUROC of the three scorings at every diagnostic SNR, for one repetition.\"\"\"\n",
    "    jscc_a, max_logit_det = p1[\"jscc_a\"], p1[\"max_logit_det\"]\n",
    "    jscc_b, prototype_det = p1[\"jscc_b\"], p1[\"prototype_det\"]\n",
    "    loaders, num_classes = p1[\"loaders\"], p1[\"num_classes\"]\n",
    "    dev_a, dev_b = next(jscc_a.parameters()).device, next(jscc_b.parameters()).device\n",
    "    _devs = [torch.cuda.current_device()] if torch.cuda.is_available() else []\n",
    "    per_snr = {}\n",
    "    for snr in _EXPLAIN_SNRS:\n",
    "        with torch.random.fork_rng(devices=_devs):\n",
    "            torch.manual_seed(eval_noise_seed(CONFIG, snr, \"awgn\"))\n",
    "            prototype_mag = PrototypeDetectorMagnitudeAware(prototype_det.patch_dim, prototype_det.patch_grid,\n",
    "                                                            num_classes, CONFIG[\"PROTOTYPE_SCALE\"]).to(dev_b)\n",
    "            prototype_mag.load_state_dict(prototype_det.state_dict())\n",
    "            prototype_mag.eval()\n",
    "            _ns = eval_noise_seed(CONFIG, snr, \"awgn\")\n",
    "            r_pr = _eval_one_system(jscc_b, prototype_det, p1[\"tau_prototype\"], p1[\"sdop_threshold_b\"],\n",
    "                                    loaders[\"test\"], snr, CONFIG, dev_b, \"awgn\", noise_seed=_ns)\n",
    "            r_pr_mag = _eval_one_system(jscc_b, prototype_mag, p1[\"tau_prototype\"], p1[\"sdop_threshold_b\"],\n",
    "                                        loaders[\"test\"], snr, CONFIG, dev_b, \"awgn\", noise_seed=_ns)\n",
    "            r_ml = _eval_one_system(jscc_a, max_logit_det, p1[\"tau_max_logit\"], p1[\"sdop_threshold_a\"],\n",
    "                                    loaders[\"test\"], snr, CONFIG, dev_a, \"awgn\", noise_seed=_ns)\n",
    "        per_snr[str(snr)] = {\"pr_auc\": float(r_pr[\"auc_roc_pixel\"]),\n",
    "                             \"pr_mag_auc\": float(r_pr_mag[\"auc_roc_pixel\"]),\n",
    "                             \"ml_auc\": float(r_ml[\"auc_roc_pixel\"])}\n",
    "    return {\"per_snr\": per_snr}\n",
    "\n",
    "\n",
    "n_reps = len(p1_grid[\"final_runs\"])\n",
    "state_path = Path(p1_grid[\"out\"]) / \"explainer_state.json\"\n",
    "# \"n_batches\" and \"version\" identify the format of explainer_state.json written by\n",
    "# earlier versions of this cell; keeping them lets those files be reused.\n",
    "_stamp = fingerprint_key({\"max_logit\": training_fingerprint(CONFIG, \"max_logit\"),\n",
    "                          \"prototype\": training_fingerprint(CONFIG, \"prototype\"),\n",
    "                          \"eval\": evaluation_fingerprint(CONFIG), \"snrs\": _EXPLAIN_SNRS, \"n_batches\": 12,\n",
    "                          \"taus\": [[r[\"tau_max_logit\"], r[\"tau_prototype\"]] for r in p1_grid[\"final_runs\"]],\n",
    "                          \"version\": 2})\n",
    "_saved = json.load(open(state_path)) if state_path.exists() else {}\n",
    "completed_reps = _saved.get(\"reps\", {}) if _saved.get(\"_stamp\") == _stamp else {}\n",
    "if _saved and not completed_reps:\n",
    "    print(f\"  {state_path} was produced under different settings -- recomputing\")\n",
    "for rep_idx, p1 in enumerate(p1_grid[\"final_runs\"]):\n",
    "    key = str(rep_idx)\n",
    "    if key in completed_reps:\n",
    "        print(f\"  Repetition {rep_idx+1}/{n_reps}: SKIP, already done (resumed)\")\n",
    "        continue\n",
    "    print(f\"  Repetition {rep_idx+1}/{n_reps}...\")\n",
    "    completed_reps[key] = _scoring_rule_aurocs(p1)\n",
    "    with open(state_path, \"w\") as f:\n",
    "        json.dump({\"_stamp\": _stamp, \"reps\": completed_reps}, f, indent=2)\n",
    "\n",
    "# mag_ablation[snr][scoring] = list over repetitions (used by the next two cells).\n",
    "mag_ablation = {snr: {\"pr\": [], \"pr_mag\": [], \"ml\": []} for snr in _EXPLAIN_SNRS}\n",
    "for rep_idx in range(n_reps):\n",
    "    for snr in _EXPLAIN_SNRS:\n",
    "        d = completed_reps[str(rep_idx)][\"per_snr\"][str(snr)]\n",
    "        mag_ablation[snr][\"pr\"].append(d[\"pr_auc\"])\n",
    "        mag_ablation[snr][\"pr_mag\"].append(d[\"pr_mag_auc\"])\n",
    "        mag_ablation[snr][\"ml\"].append(d[\"ml_auc\"])\n",
    "\n",
    "def _ms(lst):\n",
    "    arr = np.array(lst, dtype=float)\n",
    "    return arr.mean(), (arr.std(ddof=1) if arr.size > 1 else float(\"nan\"))\n",
    "\n",
    "print(f\"\\nPixel AUROC, mean +/- SD over {n_reps} repetitions (AWGN)\")\n",
    "print(f\"  {'SNR':>5}  {'Prototype':>16}  {'Prototype-mag':>16}  {'Max Logit':>16}\")\n",
    "for snr in _EXPLAIN_SNRS:\n",
    "    prm, prs = _ms(mag_ablation[snr][\"pr\"])\n",
    "    pmm, pms = _ms(mag_ablation[snr][\"pr_mag\"])\n",
    "    mlm, mls = _ms(mag_ablation[snr][\"ml\"])\n",
    "    print(f\"  {snr:>5}  {prm:>7.4f}+-{prs:<7.4f}  {pmm:>7.4f}+-{pms:<7.4f}  {mlm:>7.4f}+-{mls:<7.4f}\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "id": "cell14",
   "metadata": {},
   "source": [
    "# ==============================================================================\n",
    "#  SCORING-RULE CHECK 2/3 -- paired by repetition, not by SNR point (the SNR\n",
    "#  points share the same trained models). Each repetition is summarised by its\n",
    "#  mean AUROC over the diagnostic SNRs. Needs the previous cell's results.\n",
    "# ==============================================================================\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "per_seed_pr_arr = np.array([np.mean([mag_ablation[snr][\"pr\"][r] for snr in _EXPLAIN_SNRS]) for r in range(n_reps)])\n",
    "per_seed_pr_mag_arr = np.array([np.mean([mag_ablation[snr][\"pr_mag\"][r] for snr in _EXPLAIN_SNRS]) for r in range(n_reps)])\n",
    "per_seed_ml_arr = np.array([np.mean([mag_ablation[snr][\"ml\"][r] for snr in _EXPLAIN_SNRS]) for r in range(n_reps)])\n",
    "\n",
    "print(f\"\\n{'='*78}\\nAcross the diagnostic SNR range -- paired by repetition (N={n_reps})\\n{'='*78}\")\n",
    "\n",
    "# Below 6 repetitions the exact two-sided Wilcoxon test cannot reach p < 0.05,\n",
    "# so a paired t-test is used instead.\n",
    "if n_reps >= 6:\n",
    "    w_q1, p_q1 = stats.wilcoxon(per_seed_pr_arr, per_seed_pr_mag_arr)\n",
    "    test_name = \"Wilcoxon signed-rank\"\n",
    "else:\n",
    "    w_q1, p_q1 = stats.ttest_rel(per_seed_pr_arr, per_seed_pr_mag_arr)\n",
    "    test_name = \"paired t-test (fewer than 6 repetitions)\"\n",
    "wins_mag = int((per_seed_pr_mag_arr > per_seed_pr_arr).sum())\n",
    "_d1 = float(np.median(per_seed_pr_mag_arr - per_seed_pr_arr))\n",
    "print(\"  Q1 -- Does magnitude-aware scoring change Prototype's AUROC across the SNR range?\")\n",
